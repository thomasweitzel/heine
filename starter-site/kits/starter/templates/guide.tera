{% extends "kit/starter/base.tera" %}

{% block content %}
<article class="guide-article">
  <h1>{{ <starter.page_title draft={page.draft} label={t(id="starter-draft-marker")} title={page.title} /> }}</h1>
  {% include "kit/starter/table-of-contents.tera" %}
  <div class="prose">
    {{ markdown(content="main") }}
  </div>
</article>
{% endblock %}
