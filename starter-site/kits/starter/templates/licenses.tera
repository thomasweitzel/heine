{% extends "kit/starter/base.tera" %}

{% block content %}
<h1>{{ <starter.page_title draft={page.draft} label={t(id="starter-draft-marker")} title={page.title} /> }}</h1>
<p>{{ t(id="starter-attributions-introduction") }}</p>
<ul class="compact-index attribution-list">
{% for item in attributions() %}
  <li>
    <a href="{{ item.asset.relative_url }}">{{ item.asset.url }}</a>
    <br>
    {% if locale_data.attributions[item.asset.output_path] is defined %}
      {{ locale_data.attributions[item.asset.output_path].label }}
    {% else %}
      {{ item.licensing.copyrights | join(sep=", ") }}
    {% endif %}
    {% if item.licensing.expressions | length == 1 and item.licensing.license_texts | length == 1 %}
      (<a href="{{ item.licensing.license_texts[0].relative_url }}">{{ item.licensing.expressions[0] }}</a>)
    {% else %}
      ({{ item.licensing.expressions | join(sep="; ") }})
      {{ t(id="starter-license-texts") }}:
      {% for license in item.licensing.license_texts %}
        <a href="{{ license.relative_url }}">{{ license.id }}</a>
        {% if not loop.last %}, {% endif %}
      {% endfor %}
    {% endif %}
    {% if item.licensing.comments %}
      <br>{{ item.licensing.comments | join(sep=" ") }}
    {% endif %}
  </li>
{% endfor %}
</ul>
{% endblock %}
