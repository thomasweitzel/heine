{% extends "kit/starter/base.tera" %}

{% block title %}{{ series.title }}{% endblock %}

{% block head_description %}
  {{ <starter.meta_description value={t(id="starter-series-listing-description", series=series.title)} /> }}
{% endblock %}

{% block language_navigation %}
  {% set has_series_translation = false %}
  {% for target_locale, language in data.site.language_flags %}
    {% if target_locale != locale.code and series_has_members(id=series.id, locale=target_locale) %}
      {% set_global has_series_translation = true %}
    {% endif %}
  {% endfor %}
  {% if has_series_translation %}
    <nav class="language-navigation" aria-label="{{ t(id="starter-language") }}">
      {% for target_locale, language in data.site.language_flags %}
        {% if target_locale != locale.code and series_has_members(id=series.id, locale=target_locale) %}
          {% set target = series(id=series.id, locale=target_locale) %}
          {% set language_message = "starter-language-" ~ target_locale %}
          {% set flag = asset(id=language.asset) %}
          {{ <starter.language_link locale={target_locale} target={target} flag={flag} label={t(id=language_message)} /> }}
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}
{% endblock %}

{% block content %}
<section>
  <h1>{{ series.title }}</h1>
  {% if series.description %}
    <p>{{ series.description }}</p>
  {% endif %}
  {% if pagination.pages %}
    <ol class="series-list" start="{{ pagination.first_item_number }}">
      {% for item in pagination.pages %}
        <li class="series-list-item">
          <div class="series-list-heading">
            {{ <starter.draft_marker draft={item.draft} label={t(id="starter-draft-marker")} /> }}
            <a href="{{ item.relative_url }}">{{ item.title }}</a>
          </div>
          {% if item.summary %}<span class="series-list-summary">{{ item.summary }}</span>{% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
  {{ <starter.pagination pager={pagination} label={t(id="starter-pagination-label")} /> }}
</section>
{% endblock %}
