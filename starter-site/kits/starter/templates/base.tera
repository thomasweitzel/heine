<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="{{ locale.code }}" dir="{{ locale.direction }}">
  <head>
   <meta charset='UTF-8'>
   <title>{{ data.site.name }} - {% block title %}{{ page.title }}{% endblock %}</title>
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   {% block head_description %}
     {% if page and page.description %}
       {{ <starter.meta_description value={page.description} /> }}
     {% endif %}
   {% endblock %}
   {% set favicon = asset(id="assets/favicon.svg") %}
   <link rel="icon" href="{{ favicon.url }}" type="image/svg+xml"{% if favicon.integrity %} integrity="{{ favicon.integrity }}" crossorigin="anonymous"{% endif %}>
   <link rel="stylesheet" type="text/css" href="{{ highlight_css() }}">
   {% set styles = asset(id="assets/css/styles.css") %}
   <link rel="stylesheet" type="text/css" href="{{ styles.url }}"{% if styles.integrity %} integrity="{{ styles.integrity }}" crossorigin="anonymous"{% endif %}>
   {% set posts_feed = feed(name="posts") %}
   <link rel="alternate" type="application/atom+xml" href="{{ posts_feed.url }}" title="{{ posts_feed.title }}">
   {% if pagination %}
     <link rel="canonical" href="{{ pagination.current.absolute_url }}">
   {% elif taxonomy %}
     <link rel="canonical" href="{{ taxonomy.absolute_url }}">
   {% elif series %}
     <link rel="canonical" href="{{ series.absolute_url }}">
   {% elif page %}
     <link rel="canonical" href="{{ page.absolute_url }}">
   {% endif %}
   {% block head_extra %}{% endblock %}
  </head>
  <body>
    <header>
      <div class="site-header">
        {% set home = page(id="index") %}
        <a class="site-name" href="{{ home.url }}">{{ data.site.name }}</a>
        <div class="site-links">
          <nav class="site-navigation" aria-label="{{ t(id="starter-nav-label") }}">
            {% for item in data.site.navigation %}
            {% if item.page is defined %}
              {% if page_exists(id=item.page) %}
                {% set target = page(id=item.page) %}
                {% if item.icon is defined %}
                  {% set icon = asset(id=item.icon) %}
                  <a class="navigation-icon" href="{{ target.url }}"><img src="{{ icon.url }}" alt="{{ t(id=item.message) }}"></a>
                {% else %}
                  <a href="{{ target.url }}">{{ t(id=item.message) }}</a>
                {% endif %}
              {% endif %}
            {% elif item.taxonomy is defined %}
              {% set target = taxonomy(name=item.taxonomy) %}
              <a href="{{ target.url }}">{{ t(id=item.message) }}</a>
            {% elif item.series is defined %}
              {% set target = series() %}
              {% if target.count > 0 %}
                <a href="{{ target.url }}">{{ t(id=item.message) }}</a>
              {% endif %}
            {% endif %}
            {% endfor %}
          </nav>
          {% block language_navigation %}
            {% if page and page.translations %}
              <nav class="language-navigation" aria-label="{{ t(id="starter-language") }}">
                {% for locale, translation in page.translations %}
                  {% set translated = page(locale=locale, id=translation.id) %}
                  {% set language_message = "starter-language-" ~ locale %}
                  {% set flag = asset(id=data.site.language_flags[locale].asset) %}
                  {{ <starter.language_link locale={locale} target={translated} flag={flag} label={t(id=language_message)} /> }}
                {% endfor %}
              </nav>
            {% endif %}
          {% endblock %}
        </div>
      </div>
    </header>
    <main{% if page and page.footnotes %} class="has-margin-footnotes"{% endif %}>
      {% block page_navigation %}{% endblock %}
      {% block content %}
      {{ page.content.main }}
      {% endblock %}
      {% if page %}
        {% include "kit/starter/series-navigation.tera" %}
      {% endif %}
    </main>
    <footer>
      {% block footer %}
        <nav class="footer-links" aria-label="{{ t(id="starter-footer-label") }}">
          {% for item in data.site.footer.links %}
            {% set target = page(id=item.page) %}
            <a href="{{ target.url }}">{{ t(id=item.message) }}</a>
          {% endfor %}
        </nav>
        <div>{{ t(id="starter-footer-description") }}</div>
      {% endblock %}
    </footer>
  </body>
</html>
