{% extends "kit/starter/base.tera" %}

{% block title %}{{ t(id="starter-" ~ taxonomy.name, count=taxonomy.terms | length) }}{% endblock %}

{% block head_description %}
  {% set description_key = "starter-" ~ taxonomy.name ~ "-index-description" %}
  {{ <starter.meta_description value={t(id=description_key)} /> }}
{% endblock %}

{% block language_navigation %}
  <nav class="language-navigation" aria-label="{{ t(id="starter-language") }}">
  {% for target_locale, language in data.site.language_flags %}
    {% if target_locale != locale.code %}
      {% set target = taxonomy(name=taxonomy.name, locale=target_locale) %}
      {% set language_message = "starter-language-" ~ target_locale %}
      {% set flag = asset(id=language.asset) %}
      {{ <starter.language_link locale={target_locale} target={target} flag={flag} label={t(id=language_message)} /> }}
    {% endif %}
  {% endfor %}
  </nav>
{% endblock %}

{% block content %}
<h1>{{ t(id="starter-" ~ taxonomy.name, count=taxonomy.terms | length) }}</h1>
<ul class="compact-index">
{% for term in taxonomy.terms %}
  <li><a href="{{ term.relative_url }}">{{ term.name }}</a> <span class="item-count">{{ term.count }}</span></li>
{% endfor %}
</ul>
{% endblock %}
