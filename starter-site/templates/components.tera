{% component ui.pagination(pager, label: string) %}
  {% if pager.page_count > 1 %}
    <nav class="page-navigation pagination" aria-label="{{ label }}">
      {% for item in pager.navigation %}
        {% if item.kind == "gap" %}
          <span aria-hidden="true">…</span>
        {% elif item.current %}
          <span aria-current="page">{{ item.page_number }}</span>
        {% else %}
          <a href="{{ item.relative_url }}">{{ item.page_number }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}
{% endcomponent ui.pagination %}

{% component ui.meta_description(value: string) %}
  <meta name="description" content="{{ value }}">
{% endcomponent ui.meta_description %}

{% component ui.language_link(locale: string, target, flag, label: string) %}
  <a href="{{ target.url }}" hreflang="{{ locale }}" aria-label="{{ label }}">
    <img src="{{ flag.url }}"{% if flag.width %} width="{{ flag.width }}" height="{{ flag.height }}"{% endif %} alt="">
  </a>
{% endcomponent ui.language_link %}

{% component ui.page_list_item(entry) %}
  <li>
    <a href="{{ entry.relative_url }}">
      <span class="page-list-copy">
        <span class="page-list-title">{{ entry.title or entry.filename }}</span>
        {% if entry.summary %}<span class="page-list-summary">{{ entry.summary }}</span>{% endif %}
      </span>
    </a>
  </li>
{% endcomponent ui.page_list_item %}

{% component ui.arrow(direction: string) %}
  <svg class="navigation-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {% if direction == "up" %}
      <path d="M12 19V5M6 11l6-6 6 6"/>
    {% elif direction == "previous" %}
      <path d="M19 12H5M11 18l-6-6 6-6"/>
    {% elif direction == "next" %}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {% endif %}
  </svg>
{% endcomponent ui.arrow %}
