{% extends "base.tera" %}

{% block title %}{{ series.title }}{% endblock %}

{% block head_description %}
  {{ <ui.meta_description value={t(id="series-listing-description", series=series.title)} /> }}
{% endblock %}

{% block language_navigation %}
  {% set has_series_translation = false %}
  {% for target_locale, language in data.site.language_flags %}
    {% if target_locale != locale.code and series_has_members(id=series.id, locale=target_locale) %}
      {% set_global has_series_translation = true %}
    {% endif %}
  {% endfor %}
  {% if has_series_translation %}
    <nav class="language-navigation" aria-label="{{ t(id="language") }}">
      {% for target_locale, language in data.site.language_flags %}
        {% if target_locale != locale.code and series_has_members(id=series.id, locale=target_locale) %}
          {% set target = series(id=series.id, locale=target_locale) %}
          {% set language_message = "language-" ~ target_locale %}
          {% set flag = asset(id=language.asset) %}
          <a href="{{ target.url }}" hreflang="{{ target_locale }}" aria-label="{{ t(id=language_message) }}">
            <img src="{{ flag.url }}"{% if flag.width %} width="{{ flag.width }}" height="{{ flag.height }}"{% endif %} alt="">
          </a>
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}
{% endblock %}

{% block content %}
<section>
  <h1>{{ series.title }}</h1>
  {% if series.description %}
    <p>{{ series.description }}</p>
  {% endif %}
  {% if pagination.pages %}
    <ol class="link-list series-list" start="{{ pagination.first_item_number }}">
      {% for item in pagination.pages %}
        <li>
          <a href="{{ item.relative_url }}">{{ item.title }}</a>
          {% if item.summary %}<span class="series-list-summary">{{ item.summary }}</span>{% endif %}
        </li>
      {% endfor %}
    </ol>
  {% endif %}
  {{ <ui.pagination pager={pagination} label={t(id="pagination-label")} /> }}
</section>
{% endblock %}
