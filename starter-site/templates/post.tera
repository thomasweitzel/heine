{% extends "base.tera" %}

{% block header %}
<nav>
  {% set index = page(id=page.dir ~ "/index") %}
  Up: <a href="{{ index.relative_url }}">Index</a>
  {% if page.lighter %}
    {% set p = pages[page.lighter] %}
    {% set previous = page(id=p.id) %}
    | Prev: <a href="{{ previous.relative_url }}">{{ p.title }}</a>
  {% endif %}
  {% if page.heavier %}
    {% set p = pages[page.heavier] %}
    {% set next = page(id=p.id) %}
    | Next: <a href="{{ next.relative_url }}">{{ p.title }}</a>
  {% endif %}
</nav>
{% endblock %}

{% block content %}
<p><time datetime="{{ page.date }}">{{ page.date }}</time></p>
{% if page.extra.featured_image %}
  {% set image = asset(id=page.extra.featured_image.id) %}
  <figure class="featured-image">
    <img src="{{ image.url }}"{% if image.width %} width="{{ image.width }}" height="{{ image.height }}"{% endif %} alt="{{ page.extra.featured_image.alt }}">
  </figure>
{% endif %}
{{ page.content.main | markdown }}
{% endblock %}
