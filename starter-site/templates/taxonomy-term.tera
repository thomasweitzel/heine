{% extends "base.tera" %}

{% block title %}{{ taxonomy.term.name }}{% endblock %}

{% block head_description %}
  {% set description_key = taxonomy.name ~ "-term-description" %}
  {{ <ui.meta_description value={t(id=description_key, term=taxonomy.term.name)} /> }}
{% endblock %}

{% block language_navigation %}
  {% if taxonomy.term.counterparts %}
    <nav class="language-navigation" aria-label="{{ t(id="language") }}">
    {% for target_locale, target in taxonomy.term.counterparts %}
      {% set language_message = "language-" ~ target_locale %}
      {% set flag = asset(id=data.site.language_flags[target_locale].asset) %}
      {{ <ui.language_link locale={target_locale} target={target} flag={flag} label={t(id=language_message)} /> }}
    {% endfor %}
    </nav>
  {% endif %}
{% endblock %}

{% block content %}
<h1>{{ t(id=taxonomy.name, count=1) }}: {{ taxonomy.term.name }}</h1>
<ul class="page-list">
{% for post in pagination.pages %}
  {{ <ui.page_list_item entry={post} draft_label={t(id="draft-marker")} /> }}
{% endfor %}
</ul>
{{ <ui.pagination pager={pagination} label={t(id="pagination-label")} /> }}
{% endblock %}
