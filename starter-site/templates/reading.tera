{% extends "document.tera" %}

{% block document_header %}
<h1>{{ <ui.page_title draft={page.draft} label={t(id="draft-marker")} title={page.title} /> }}</h1>
{% if page.taxonomies.authors %}
  {% set authors = taxonomy(name="authors") %}
  <div class="page-meta">
    <p><a href="{{ authors.relative_url }}">{{ t(id="authors", count=page.taxonomies.authors | length) }}</a>:
      {% for author in page.taxonomies.authors %}
        <a href="{{ author.relative_url }}">{{ author.name }}</a>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
  </div>
{% endif %}
{% endblock %}

{% block page_navigation %}
  {% set up = page(id=page.extra.parent) %}
  {% set neighbors = collection_neighbors(name="readings") %}
  <nav class="page-local-navigation" aria-label="{{ t(id="page-navigation") }}">
    <a href="{{ up.relative_url }}">{{ <ui.arrow direction="up" /> }}<span>{{ <ui.page_label draft={up.draft} label={t(id="draft-marker")} title={up.title} /> }}</span></a>
    {% if neighbors.before %}
      <a href="{{ neighbors.before.relative_url }}">{{ <ui.arrow direction="previous" /> }}<span>{{ <ui.page_label draft={neighbors.before.draft} label={t(id="draft-marker")} title={neighbors.before.title} /> }}</span></a>
    {% endif %}
    {% if neighbors.after %}
      <a href="{{ neighbors.after.relative_url }}"><span>{{ <ui.page_label draft={neighbors.after.draft} label={t(id="draft-marker")} title={neighbors.after.title} /> }}</span>{{ <ui.arrow direction="next" /> }}</a>
    {% endif %}
  </nav>
{% endblock %}
