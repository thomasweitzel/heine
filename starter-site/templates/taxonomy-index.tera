{% extends "base.tera" %}

{% block title %}{{ t(id=taxonomy.name, count=taxonomy.terms | length) }}{% endblock %}

{% block language_navigation %}
  <nav class="language-navigation" aria-label="{{ t(id="language") }}">
  {% for target_locale, language in data.site.language_flags %}
    {% if target_locale != locale.code %}
      {% set target = taxonomy(name=taxonomy.name, locale=target_locale) %}
      {% set language_message = "language-" ~ target_locale %}
      {% set flag = asset(id=language.asset) %}
      <a href="{{ target.url }}" hreflang="{{ target_locale }}" aria-label="{{ t(id=language_message) }}">
        <img src="{{ flag.url }}"{% if flag.width %} width="{{ flag.width }}" height="{{ flag.height }}"{% endif %} alt="">
      </a>
    {% endif %}
  {% endfor %}
  </nav>
{% endblock %}

{% block content %}
<h1>{{ t(id=taxonomy.name, count=taxonomy.terms | length) }}</h1>
<ul>
{% for tag in taxonomy.terms %}
  <li><a href="{{ tag.relative_url }}">{{ tag.name }}</a> <span class="item-count">{{ tag.count }}</span></li>
{% endfor %}
</ul>
{% endblock %}
