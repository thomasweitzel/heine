{% extends "base.tera" %}
{% block header %}
{% if page.extra.parent %}
  {% set up = page(id=page.extra.parent) %}
  <nav class="page-navigation">
    {{ t(id="up") }}: <a href="{{ up.url }}">{{ up.title }}</a>
  </nav>
{% endif %}
{% endblock %}
{% block content %}

{% if page.content.main %}
  {{ page.content.main | markdown }}
{% endif %}

{% if pagination %}
  {% if page.extra.count_message %}
    <p>{{ t(id=page.extra.count_message, count=pagination.item_count) }}</p>
  {% endif %}
  <hr>
  <nav class="link-stack">
    {% for post in pagination.pages %}
      <a href="{{ post.relative_url }}">{{ post.title or post.filename }}</a>
    {% endfor %}
  </nav>
  {% if pagination.page_count > 1 %}
    <nav class="page-navigation" aria-label="Pagination">
      {% for item in pagination.navigation %}
        {% if item.kind == "gap" %}
          <span aria-hidden="true">…</span>
        {% elif item.current %}
          <span aria-current="page">{{ item.page_number }}</span>
        {% else %}
          <a href="{{ item.relative_url }}">{{ item.page_number }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  {% endif %}
{% else %}
  {% set entries = siblings() %}
  {% if entries %}
    {% if page.extra.count_message %}
      <p>{{ t(id=page.extra.count_message, count=entries | length) }}</p>
    {% endif %}
    <hr>
    <nav class="link-stack">
      {% for p in entries %}
        {% set sibling = page(id=p) %}
        <a href="{{ sibling.relative_url }}">{{ sibling.title or sibling.filename }}</a>
      {% endfor %}
    </nav>
  {% endif %}
{% endif %}
{% endblock %}
