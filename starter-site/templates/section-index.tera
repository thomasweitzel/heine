{% extends "base.tera" %}
{% block header %}
{% if page.extra.parent %}
  {% set up = page(id=page.extra.parent) %}
  <nav class="page-navigation">
    <a href="{{ up.url }}"><span aria-hidden="true">↑</span><span>{{ up.title }}</span></a>
  </nav>
{% endif %}
{% endblock %}
{% block content %}

{% if page.content.main %}
  {{ page.content.main | markdown }}
{% endif %}

{% if pagination %}
  {% if page.extra.count_message %}
    <p>{{ t(id=page.extra.count_message, count=pagination.item_count) }}</p>
  {% endif %}
  {% set posts_feed = feed(name="posts") %}
  <p><a href="{{ posts_feed.url }}">{{ t(id="feed-subscribe") }}</a></p>
  <nav aria-label="{{ page.title }}">
    <ol class="page-list">
    {% for post in pagination.pages %}
      <li>
        <a href="{{ post.relative_url }}">
          <span class="page-list-copy">
            <span class="page-list-title">{{ post.title or post.filename }}</span>
            {% if post.summary %}<span class="page-list-summary">{{ post.summary }}</span>{% endif %}
          </span>
        </a>
      </li>
    {% endfor %}
    </ol>
  </nav>
  {{ <ui.pagination pager={pagination} label={t(id="pagination-label")} /> }}
{% else %}
  {% set entries = siblings() %}
  {% if entries %}
    {% if page.extra.count_message %}
      <p>{{ t(id=page.extra.count_message, count=entries | length) }}</p>
    {% endif %}
    <nav aria-label="{{ page.title }}">
      <ol class="page-list">
      {% for p in entries %}
        {% set sibling = page(id=p) %}
        <li>
          <a href="{{ sibling.relative_url }}">
            <span class="page-list-copy">
              <span class="page-list-title">{{ sibling.title or sibling.filename }}</span>
              {% if sibling.summary %}<span class="page-list-summary">{{ sibling.summary }}</span>{% endif %}
            </span>
          </a>
        </li>
      {% endfor %}
      </ol>
    </nav>
  {% endif %}
{% endif %}
{% endblock %}
