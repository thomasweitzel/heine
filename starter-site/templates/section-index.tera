{% extends "base.tera" %}
{% block page_navigation %}
{% if page.extra.parent %}
  {% set up = page(id=page.extra.parent) %}
  <nav class="page-local-navigation" aria-label="{{ t(id="page-navigation") }}">
    <a href="{{ up.url }}">{{ <ui.arrow direction="up" /> }}<span>{{ <ui.page_label draft={up.draft} label={t(id="draft-marker")} title={up.title} /> }}</span></a>
  </nav>
{% endif %}
{% endblock %}
{% block content %}

<h1>{{ <ui.page_title draft={page.draft} label={t(id="draft-marker")} title={page.title} /> }}</h1>

{% if page.content.main %}
  {% include "table-of-contents.tera" %}
  <div class="prose">
    {{ markdown(content="main") }}
  </div>
{% endif %}

{% if pagination %}
  {% if page.extra.count_message %}
    <p>{{ t(id=page.extra.count_message, count=pagination.item_count) }}</p>
  {% endif %}
  {% if page.extra.feed is defined %}
    {% set subscription = feed(name=page.extra.feed) %}
    <p><a href="{{ subscription.url }}">{{ t(id="feed-subscribe") }}</a></p>
  {% endif %}
  <nav aria-label="{{ page.title }}">
    <ol class="page-list">
    {% for post in pagination.pages %}
      {% set reading_facts = "" %}
      {% if post.markdown.main.reading_time %}{% set reading_facts = t(id="reading-facts", words=post.markdown.main.word_count, minutes=post.markdown.main.reading_time) %}{% endif %}
      {{ <ui.page_list_item entry={post} draft_label={t(id="draft-marker")} reading_facts={reading_facts} /> }}
    {% endfor %}
    </ol>
  </nav>
  {{ <ui.pagination pager={pagination} label={t(id="pagination-label")} /> }}
{% else %}
  {% set entries = siblings() %}
  {% if entries %}
    {% if page.extra.count_message %}
      <p>{{ t(id=page.extra.count_message, count=entries | length) }}</p>
    {% endif %}
    <nav aria-label="{{ page.title }}">
      <ol class="page-list">
      {% for p in entries %}
        {% set sibling = page(id=p) %}
        {% set reading_facts = "" %}
        {% if sibling.markdown.main.reading_time %}{% set reading_facts = t(id="reading-facts", words=sibling.markdown.main.word_count, minutes=sibling.markdown.main.reading_time) %}{% endif %}
        {{ <ui.page_list_item entry={sibling} draft_label={t(id="draft-marker")} reading_facts={reading_facts} /> }}
      {% endfor %}
      </ol>
    </nav>
  {% endif %}
{% endif %}
{% endblock %}
