{% extends "base.tera" %}
{% block header %}
{% if page.extra.parent %}
  {% set up = page(id=page.extra.parent) %}
  <nav class="page-navigation" aria-label="{{ t(id="page-navigation") }}">
    <a href="{{ up.url }}">{{ <ui.arrow direction="up" /> }}<span>{{ up.title }}</span></a>
  </nav>
{% endif %}
{% endblock %}
{% block content %}

{% if page.content.main %}
  {% include "table-of-contents.tera" %}
  {{ markdown(content="main") }}
{% endif %}

{% if pagination %}
  {% if page.extra.count_message %}
    <p>{{ t(id=page.extra.count_message, count=pagination.item_count) }}</p>
  {% endif %}
  {% if page.extra.feed is defined %}
    {% set subscription = feed(name=page.extra.feed) %}
    <p><a href="{{ subscription.url }}">{{ t(id="feed-subscribe") }}</a></p>
  {% endif %}
  <nav aria-label="{{ page.title }}">
    <ol class="page-list">
    {% for post in pagination.pages %}
      {{ <ui.page_list_item entry={post} /> }}
    {% endfor %}
    </ol>
  </nav>
  {{ <ui.pagination pager={pagination} label={t(id="pagination-label")} /> }}
{% else %}
  {% set entries = siblings() %}
  {% if entries %}
    {% if page.extra.count_message %}
      <p>{{ t(id=page.extra.count_message, count=entries | length) }}</p>
    {% endif %}
    <nav aria-label="{{ page.title }}">
      <ol class="page-list">
      {% for p in entries %}
        {% set sibling = page(id=p) %}
        {{ <ui.page_list_item entry={sibling} /> }}
      {% endfor %}
      </ol>
    </nav>
  {% endif %}
{% endif %}
{% endblock %}
